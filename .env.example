# this is a high grade mega ai platform which is capable of completion in any situation it may be faced with

# Required for Auth.js session encryption.
# Local: generate with `openssl rand -base64 32`.
# Production (Vercel): set this in Project Settings → Environment Variables.
AUTH_SECRET=replace-with-a-32-byte-base64-secret

# Local development defaults (match docker-compose.yml)
# Docker defaults: user=postgres ****** db=mega_ai
POSTGRES_URL=postgresql://postgres:${POSTGRES_PASSWORD:-postgres}@localhost:5432/mega_ai
REDIS_URL=redis://localhost:6379

# Required for AI responses outside Vercel's automatic OIDC flow.
# Production (Vercel): either use AI Gateway + OIDC or provide a key manually.
AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-key

# Required for attachment upload support.
# Production (Vercel): create a Blob store and set this token in Vercel env vars.
BLOB_READ_WRITE_TOKEN=replace-with-your-vercel-blob-read-write-token
